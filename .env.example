NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000/api
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lola_admin
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
REFRESH_TOKEN_EXPIRES_IN_DAYS=14
PUBLIC_INQUIRY_ALLOWED_ORIGINS=http://localhost:5173,https://lolabooths.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=storage/uploads
# Azure is backend-only. Keep local until staging upload/read/recovery passes.
# Use distinct container-scoped identities for staging and production.
AZURE_STORAGE_ENV=
AZURE_STORAGE_ACCOUNT_URL=https://thelolabooths3.blob.core.windows.net/
AZURE_STORAGE_TENANT_ID=
AZURE_STORAGE_CLIENT_ID=
AZURE_STORAGE_CLIENT_SECRET=
AZURE_DOCUMENTS_CONTAINER=
GALLERY_AZURE_CONTAINER=
EMAIL_PROVIDER=development
EMAIL_FROM=The LOLA Booth <info@thelolabooth.com>
FORM_NOTIFICATION_EMAIL=info@thelolabooth.com
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SENDER_EMAIL=
SMS_PROVIDER=none
PUBLIC_BASE_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
INTEGRATION_SECRET_KEY=replace-with-a-long-random-secret-for-encrypting-integration-credentials
META_WEBHOOK_VERIFY_TOKEN=
TIKTOK_WEBHOOK_SECRET=
LINKEDIN_API_VERSION=202609

# Optional secure document/payment host; defaults to CLIENT_ORIGIN, not the public marketing website.
PUBLIC_DOCUMENT_BASE_URL=

# Marketing adapters: explicitly opt in on backend only after qualification.
GA4_ENABLED=false
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
META_EVENTS_ENABLED=false
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=
META_TEST_EVENT_CODE=
TIKTOK_EVENTS_ENABLED=false
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=

# Deployment purpose is separate from NODE_ENV (keep production runtime optimizations).
APP_ENV=development
# Production V1.1 rollout: enable only after migrations 040–045 and release checks.
V11_CLIENT_WORKFLOW_ENABLED=false
# In staging automatic jobs remain paused. Goal 1 sends no external emails.
STAGING_EMAIL_ENABLED=false
STAGING_EMAIL_ALLOWLIST=

# Campaign links/assets must point to the public admin frontend in this environment.
CAMPAIGN_PUBLIC_ORIGIN=https://stagingadmin.thelolabooth.com
# OFF by default. Staging still requires STAGING_EMAIL_ENABLED and its QA allowlist.
CAMPAIGN_JOBS_ENABLED=false

# Approved aliases belonging to MICROSOFT_SENDER_EMAIL. Exchange must allow send-from-alias.
MICROSOFT_FROM_ALIASES=lola@thelolabooth.com
# Public backend origin (not the admin frontend). Required when queuing tracked campaigns.
CAMPAIGN_TRACKING_ORIGIN=https://stagingapi.thelolabooth.com

# External Integrations Hub: server-only OAuth credentials. Separate staging apps.
# INTEGRATION_SECRET_KEY already encrypts connection credentials; minimum 32 random characters.
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# Set only after approval for the Business Lead Generation product.
TIKTOK_LEAD_ACCESS_APPROVED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANALYTICS_REDIRECT_URI=
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=
MAILCHIMP_REDIRECT_URI=
MAILCHIMP_WEBHOOK_SECRET=
# Copy the one-time HMAC signing secret when creating a signed Mailchimp webhook.
MAILCHIMP_WEBHOOK_SIGNING_SECRET=
# Explicit opt-in for isolated external provider UAT jobs; does not enable staging mail/outbound pixels.
STAGING_EXTERNAL_INTEGRATIONS_ENABLED=false
# Enable only after queue inventory and approved planning/proof reminder delivery UAT.
PLANNING_REMINDERS_ENABLED=false
