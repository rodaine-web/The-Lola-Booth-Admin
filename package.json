{
  "name": "lola-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/src/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/src/index.js",
    "worker": "node server/src/worker.js",
    "env:check": "node server/src/config/env-check.js",
    "db:migrate": "node server/src/db/migrate.js",
    "db:seed": "node server/seeds/seed.js",
    "email:test": "node server/src/scripts/email-smoke.js",
    "test": "node --test",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.542.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.1.2",
    "sanitize-html": "^2.17.7",
    "vite": "^7.1.4",
    "zod": "^4.1.5"
  }
}
